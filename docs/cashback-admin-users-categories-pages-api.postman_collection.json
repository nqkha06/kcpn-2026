  "info": {
    "_postman_id": "afb24918-a75b-4d61-8188-13b52d5e5d12",
    "name": "Cashback Admin Users Categories Pages API",
    "description": "Postman Collection kiểm thử 15 endpoint Admin Users, Admin Categories và Admin Pages. Backend dùng prefix /api/v1 và Laravel Sanctum theo session cookie. Collection thêm CSRF Cookie và Login làm hai request hỗ trợ. Chạy các folder theo thứ tự; mỗi chuỗi CRUD chỉ xóa resource do chính collection vừa tạo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Origin', value: pm.variables.replaceIn('{{frontend_url}}') });",
          "pm.request.headers.upsert({ key: 'Referer', value: pm.variables.replaceIn('{{frontend_url}}/') });",
          "",
          "const unsafeMethods = ['POST', 'PUT', 'PATCH', 'DELETE'];",
          "const xsrfToken = pm.collectionVariables.get('xsrf_token');",
          "if (unsafeMethods.includes(pm.request.method) && xsrfToken) {",
          "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: xsrfToken });",
          "}"
        ]
      }
    }
  ],
