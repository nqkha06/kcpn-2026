  "item": [
    {
      "name": "00 - Authentication",
      "description": "Điền admin_password trong collection variables, sau đó chạy hai request theo thứ tự để tạo CSRF/session cookie và đăng nhập admin.",
      "item": [
        {
          "name": "GET /sanctum/csrf-cookie (helper)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/sanctum/csrf-cookie",
            "description": "Route thực tế là /api/v1/sanctum/csrf-cookie. Response 204 đặt XSRF-TOKEN và session cookie."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF cookie response is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "let encodedToken = pm.cookies.get('XSRF-TOKEN');",
                  "",
                  "if (!encodedToken) {",
                  "    const setCookieHeaders = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie');",
                  "    for (let i = 0; i < setCookieHeaders.length; i++) {",
                  "        if (setCookieHeaders[i].value.includes('XSRF-TOKEN')) {",
                  "            const match = setCookieHeaders[i].value.match(/XSRF-TOKEN=([^;]+)/);",
                  "            if (match) {",
                  "                encodedToken = match[1];",
                  "                break;",
                  "            }",
                  "        }",
                  "    }",
                  "}",
                  "",
                  "pm.test('XSRF-TOKEN cookie is present', function () {",
                  "    pm.expect(encodedToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (encodedToken) {",
                  "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(encodedToken));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (helper)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{admin_email}}\",\n    \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/auth/login"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "",
                  "if (pm.response.code === 200 && !pm.response.json().data.requires_two_factor) {",
                  "    pm.test('Authenticated account has admin role', function () {",
                  "        pm.expect(pm.response.json().data.user.roles).to.include('admin');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
