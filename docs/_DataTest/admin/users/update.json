[
    {
        "case_id": "ADM-USR-UPDATE-EP-001",
        "description": "updates a user without sending a password",
        "actor": "admin",
        "preconditions": [
            "admin_exists",
            "managed_user_exists",
            "role_exists",
            "original_password_captured"
        ],
        "request": {
            "method": "PUT",
            "endpoint": "/api/v1/admin/users/{user}",
            "headers": {
                "Accept": "application/json"
            },
            "path": {
                "user": "@user.id"
            },
            "query": {},
            "body": {
                "name": "Updated User",
                "email": "updated-user@example.test",
                "roles": [
                    "@role.id"
                ]
            }
        },
        "expected": {
            "status": 200,
            "json_paths": {
                "success": true,
                "data.id": "@user.id",
                "data.name": "Updated User",
                "data.email": "updated-user@example.test"
            },
            "json_absent": [
                "data.password",
                "data.remember_token"
            ],
            "validation_errors": [],
            "database_change": {
                "table": "users",
                "operation": "update",
                "where": {
                    "id": "@user.id"
                }
            }
        },
        "capture": {
            "user_id": "data.id"
        }
    },
