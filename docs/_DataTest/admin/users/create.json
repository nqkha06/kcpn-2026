                },
                "data.email": "name-1@example.test"
            },
            "json_absent": [
                "data.password",
                "data.remember_token"
            ],
            "validation_errors": [],
            "database_change": {
                "table": "users",
                "operation": "insert",
                "where": {
                    "email": "name-1@example.test"
                }
            }
        },
        "capture": {
            "user_id": "data.id"
        }
