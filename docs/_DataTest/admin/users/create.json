        "preconditions": [
            "admin_exists",
            "role_exists"
        ],
        "request": {
            "method": "POST",
            "endpoint": "/api/v1/admin/users",
            "headers": {
                "Accept": "application/json"
            },
            "path": {},
            "query": {},
            "body": {
                "name": {
                    "generator": "repeat",
                    "character": "n",
                    "length": 1
                },
                "email": "name-1@example.test",
                "password": "@new_user.password",
                "password_confirmation": "@new_user.password",
                "roles": [
                    "@role.id"
                ]
            }
        },
        "expected": {
            "status": 201,
            "json_paths": {
                "success": true,
                "data.name": {
                    "generator": "repeat",
                    "character": "n",
