[
    {
        "case_id": "ADM-TXN-UPDATE-EP-001",
        "description": "updates a transaction from expense to income",
        "actor": "admin",
        "preconditions": [
            "admin_exists",
            "transaction_with_owner_wallet_exists",
            "global_category_exists"
        ],
        "request": {
            "method": "PUT",
            "endpoint": "/api/v1/admin/transactions/{transaction}",
            "headers": {
                "Accept": "application/json"
            },
            "path": {
                "transaction": "@transaction.id"
            },
            "query": {},
            "body": {
                "user_id": "@user.id",
                "wallet_id": "@wallet.id",
                "category_id": "@category.id",
                "type": "income",
                "amount": 5000000000,
                "transacted_at": "2026-08-15",
                "status": "posted",
                "note": "Nominal transaction note",
                "labels": [
                    "nominal-label"
                ]
            }
        },
        "expected": {
            "status": 200,
            "json_paths": {
                "success": true,
                "data.id": "@transaction.id",
                "data.type": "income"
            },
            "json_absent": [],
            "validation_errors": [],
            "database_change": {
                "table": "expense_transactions",
                "operation": "update",
                "where": {
                    "id": "@transaction.id"
                }
            }
        },
        "capture": {
            "transaction_id": "data.id"
        }
    },
