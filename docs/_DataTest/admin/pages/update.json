    {
        "case_id": "ADM-PAGE-UPDATE-EP-001",
        "description": "updates a page and category relation",
        "actor": "admin",
        "preconditions": [
            "admin_exists",
            "managed_page_exists",
            "page_category_exists"
        ],
        "request": {
            "method": "PUT",
            "endpoint": "/api/v1/admin/pages/{page}",
            "headers": {
                "Accept": "application/json"
            },
            "path": {
                "page": "@page.id"
            },
            "query": {},
            "body": {
                "title": "Updated Page",
                "slug": "updated-page",
                "image": null,
                "category_id": "@category.id",
                "tags": [
                    "nominal-tag"
                ],
                "content": "Nominal page content",
                "meta_title": "Nominal meta title",
                "meta_description": "Nominal meta description",
                "meta_keywords": "nominal, page",
                "status": "published"
            }
        },
        "expected": {
            "status": 200,
            "json_paths": {
                "success": true,
                "data.id": "@page.id",
                "data.title": "Updated Page",
                "data.status": "published",
                "data.slug": "updated-page",
                "data.category.id": "@category.id"
            },
            "json_absent": [],
            "validation_errors": [],
            "database_change": {
                "table": "pages",
                "operation": "update",
                "where": {
                    "id": "@page.id"
                }
            }
        },
        "capture": {
            "page_id": "data.id",
            "page_slug": "data.slug"
        }
    },
