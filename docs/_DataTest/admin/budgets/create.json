  {
    "case_id": "ADM-BDG-CREATE-BVA-001",
    "description": "minimum amount",
    "actor": "admin",
    "preconditions": [
      "customer",
      "global_category"
    ],
    "request": {
      "method": "POST",
      "endpoint": "/api/v1/admin/budgets",
      "headers": {
        "Accept": "application/json"
      },
      "path": {},
      "query": {},
      "body": {
        "user_id": "@customer.id",
        "category_id": "@category.id",
        "amount_limit": 0.01,
        "period": "monthly",
        "status": "active",
        "note": "Nominal budget"
      }
    },
    "expected": {
      "status": 201,
      "json_paths": {
        "message": "Budget created successfully",
        "data.amount_limit": 0.01,
        "data.spent": 0
      },
      "json_absent": [],
      "validation_errors": [],
      "database_change": {
        "operation": "insert",
        "table": "budgets",
        "where": {
          "user_id": "@customer.id",
          "category_id": "@category.id",
          "amount_limit": 0.01
        }
      }
    },
    "capture": {
      "budget.id": "data.id"
    }
  },
