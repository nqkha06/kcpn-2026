    "case_id": "USR-BDG-CREATE-RBAC-015",
    "description": "admin role should be forbidden by user route",
    "actor": "admin",
    "preconditions": [
      "global_category"
    ],
    "request": {
      "method": "POST",
      "endpoint": "/api/v1/user/budgets",
      "headers": {
        "Accept": "application/json"
      },
      "path": {},
      "query": {},
      "body": {
