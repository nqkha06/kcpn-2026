        "amount_limit": 5000000000,
        "period": "monthly",
        "note": "Nominal budget"
      }
    },
    "expected": {
      "status": 403,
      "json_paths": {
        "message": "Forbidden"
      },
      "json_absent": [],
      "validation_errors": [],
      "database_change": {
        "operation": "none",
        "table": null,
        "where": {}
      }
    },
    "blocked": true,
    "blocked_reason": "Bug: route role:user|admin and BudgetPolicy currently allow admin; observed request reaches validation (422) instead of the required role rejection (403). With a valid global category, successful creation is inferred from the route and policy."
  }
