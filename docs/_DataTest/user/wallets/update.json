[
    {
        "case_id": "USR-WAL-UPDATE-BVA-001",
        "description": "accepts wallet name length 1",
        "actor": "user",
        "preconditions": [
            "user_with_wallet_exists"
        ],
        "request": {
            "method": "PUT",
            "endpoint": "/api/v1/user/wallets/{wallet}",
            "headers": {
                "Accept": "application/json"
            },
            "path": {
                "wallet": "@wallet.id"
            },
            "query": {},
            "body": {
                "name": {
                    "generator": "repeat",
                    "character": "w",
                    "length": 1
                },
                "currency": "VND",
                "opening_balance": 0,
                "is_default": false
            }
        },
        "expected": {
            "status": 200,
            "json_paths": {
                "success": true,
                "data.name": {
                    "generator": "repeat",
                    "character": "w",
                    "length": 1
                }
            },
            "json_absent": [],
            "validation_errors": [],
            "database_change": {
                "table": "user_wallets",
                "operation": "update",
                "where": {
                    "id": "@wallet.id"
                }
            }
        },
        "capture": {
            "wallet_id": "data.id"
        }
    },
