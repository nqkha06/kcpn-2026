[
    {
        "case_id": "USR-WAL-CREATE-BVA-001",
        "description": "accepts wallet name length 1",
        "actor": "user",
        "preconditions": [
            "user_exists"
        ],
        "request": {
            "method": "POST",
            "endpoint": "/api/v1/user/wallets",
            "headers": {
                "Accept": "application/json"
            },
            "path": {},
            "query": {},
            "body": {
                "name": {
                    "generator": "repeat",
                    "character": "w",
                    "length": 1
                },
                "currency": "VND",
                "opening_balance": 0,
                "is_default": false
            }
        },
        "expected": {
            "status": 201,
            "json_paths": {
                "success": true,
                "data.name": {
                    "generator": "repeat",
                    "character": "w",
                    "length": 1
                }
            },
            "json_absent": [],
            "validation_errors": [],
            "database_change": {
                "table": "user_wallets",
                "operation": "insert",
                "where": {
                    "user_id": "@user.id",
                    "name": {
                        "generator": "repeat",
                        "character": "w",
                        "length": 1
                    }
                }
            }
        },
        "capture": {
            "wallet_id": "data.id"
        }
    },
