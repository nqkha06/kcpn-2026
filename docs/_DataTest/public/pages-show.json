[
    {
        "case_id": "PUB-PAGE-SHOW-EP-001",
        "description": "A published page is public",
        "actor": "guest",
        "preconditions": ["published_page_exists"],
        "request": {
            "method": "GET",
            "endpoint": "/api/v1/public/pages/{slug}",
            "headers": { "Accept": "application/json" },
            "path": { "slug": "@published_page.slug" },
            "query": {},
            "body": {}
        },
        "expected": {
            "status": 200,
            "json_paths": {
                "success": true,
                "data.slug": "@published_page.slug"
            },
            "json_absent": ["data.user_id", "data.author", "data.category_id"],
            "validation_errors": [],
            "database_change": { "table": "pages", "operation": "none" }
        },
        "capture": { "public_page_id": "data.id" }
    },
