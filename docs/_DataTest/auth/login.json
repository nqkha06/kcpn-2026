        "case_id": "AUTH-LOGIN-SUBMIT-EP-007",
        "description": "Login starts a two-factor challenge for a confirmed 2FA user",
        "actor": "guest",
        "preconditions": ["two_factor_user_exists"],
        "request": {
            "method": "POST",
            "endpoint": "/api/v1/auth/login",
            "headers": {
                "Accept": "application/json",
                "Origin": "http://localhost"
            },
            "path": {},
            "query": {},
            "body": {
                "email": "@two_factor_user.email",
                "password": "@two_factor_user.password"
            }
        },
        "expected": {
            "status": 200,
            "json_paths": {
                "success": true,
                "data.requires_two_factor": true,
                "data.user": null
            },
            "json_absent": ["data.user.password"],
            "validation_errors": [],
            "database_change": { "table": "users", "operation": "none" }
        },
        "capture": { "two_factor_session": "data.requires_two_factor" }
    },
