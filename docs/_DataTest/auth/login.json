[
    {
        "case_id": "AUTH-LOGIN-SUBMIT-EP-001",
        "description": "Login succeeds with valid credentials",
        "actor": "guest",
        "preconditions": ["user_exists"],
        "request": {
            "method": "POST",
            "endpoint": "/api/v1/auth/login",
            "headers": { "Accept": "application/json" },
            "path": {},
            "query": {},
            "body": {
                "email": "@user.email",
                "password": "@user.password",
                "remember": true
            }
        },
        "expected": {
            "status": 200,
            "json_paths": {
                "success": true,
                "data.requires_two_factor": false
            },
            "json_absent": [
                "data.user.password",
                "data.user.remember_token",
                "data.user.two_factor_secret",
                "data.user.two_factor_recovery_codes"
            ],
            "validation_errors": [],
            "database_change": { "table": "users", "operation": "none" }
        }
    },
    {
        "case_id": "AUTH-LOGIN-SUBMIT-EP-002",
