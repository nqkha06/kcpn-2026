    {
        "case_id": "AUTH-REG-CREATE-BVA-001",
        "description": "Name accepts minimum length 1",
        "actor": "guest",
        "preconditions": ["email_available"],
        "request": {
            "method": "POST",
            "endpoint": "/api/v1/auth/register",
            "headers": { "Accept": "application/json" },
            "path": {},
            "query": {},
            "body": {
                "name": {
                    "generator": "repeat",
                    "character": "a",
                    "length": 1
                },
                "email": "register-name-1@example.com",
                "password": "password",
                "password_confirmation": "password"
            }
        },
        "expected": {
            "status": 201,
            "json_paths": {
                "success": true,
                "data.user.email": "register-name-1@example.com"
            },
            "json_absent": ["data.user.password", "data.user.remember_token"],
            "validation_errors": [],
            "database_change": {
                "table": "users",
                "operation": "insert",
                "where": { "email": "register-name-1@example.com" }
            }
        }
    },
