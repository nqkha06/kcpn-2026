[
    {
        "case_id": "AUTH-RESET-UPDATE-EP-001",
        "description": "A valid reset token updates the password",
        "actor": "guest",
        "preconditions": ["user_exists", "valid_reset_token"],
        "request": {
            "method": "POST",
            "endpoint": "/api/v1/auth/reset-password",
            "headers": { "Accept": "application/json" },
            "path": {},
            "query": {},
            "body": {
                "token": "@reset.token",
                "email": "@user.email",
                "password": "new-password",
                "password_confirmation": "new-password"
            }
        },
        "expected": {
            "status": 200,
            "json_paths": { "success": true },
            "json_absent": ["data.token", "data.password"],
            "validation_errors": [],
            "database_change": {
                "table": "users",
                "operation": "update",
                "field": "password"
            }
        }
    },
    {
        "case_id": "AUTH-RESET-UPDATE-EP-002",
