            "path": {},
            "query": {},
            "body": { "email": "missing-forgot@example.com" }
        },
        "expected": {
            "status": 422,
            "json_paths": { "success": false },
            "json_absent": ["data.token"],
            "validation_errors": ["email"],
            "database_change": {
                "table": "password_reset_tokens",
                "operation": "none"
            }
        }
    },
