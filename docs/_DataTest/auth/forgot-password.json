[
    {
        "case_id": "AUTH-FORGOT-SEND-EP-001",
        "description": "A reset link is sent for an existing email",
        "actor": "guest",
        "preconditions": ["user_exists"],
        "request": {
            "method": "POST",
            "endpoint": "/api/v1/auth/forgot-password",
            "headers": { "Accept": "application/json" },
            "path": {},
            "query": {},
            "body": { "email": "@user.email" }
        },
        "expected": {
            "status": 200,
            "json_paths": { "success": true },
            "json_absent": ["data.token"],
            "validation_errors": [],
            "database_change": {
                "table": "password_reset_tokens",
                "operation": "insert",
                "where": { "email": "@user.email" }
            }
        },
        "capture": {}
    },
    {
        "case_id": "AUTH-FORGOT-SEND-EP-002",
        "description": "An unknown email is rejected without a notification",
