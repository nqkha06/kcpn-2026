                  "value": "1"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Budget list is paginated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.meta).to.have.property('total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /admin/budgets/options",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/admin/budgets/options",
            "description": "Ngoài kiểm thử endpoint, test script sẽ tự điền budget_user_id và budget_category_id nếu các biến đang trống."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Budget options are returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.users).to.be.an('array').and.not.empty;",
                  "    pm.expect(data.categories).to.be.an('array').and.not.empty;",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json().data;",
                  "    if (!pm.collectionVariables.get('budget_user_id') && data.users.length > 0) {",
                  "        pm.collectionVariables.set('budget_user_id', String(data.users[0].id));",
                  "    }",
                  "",
                  "    const userId = Number(pm.collectionVariables.get('budget_user_id'));",
                  "    const compatibleCategory = data.categories.find(function (category) {",
                  "        return category.user_id === null || Number(category.user_id) === userId;",
                  "    });",
                  "",
                  "    if (!pm.collectionVariables.get('budget_category_id') && compatibleCategory) {",
                  "        pm.collectionVariables.set('budget_category_id', String(compatibleCategory.id));",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /admin/budgets",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": {{budget_user_id}},\n    \"category_id\": {{budget_category_id}},\n    \"amount_limit\": 1000000,\n    \"period\": \"yearly\",\n    \"status\": \"active\",\n    \"note\": \"Created from Postman collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/admin/budgets",
            "description": "user_id và category_id phải tồn tại; category phải là global hoặc thuộc user. Bộ ba user_id + category_id + period phải là duy nhất."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Budget is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().data).to.have.property('id');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('budget_id', String(pm.response.json().data.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /admin/budgets/{budget}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/admin/budgets/{{budget_id}}"
