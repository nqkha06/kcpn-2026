            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": {{budget_user_id}},\n    \"category_id\": {{budget_category_id}},\n    \"amount_limit\": 1500000,\n    \"period\": \"yearly\",\n    \"status\": \"inactive\",\n    \"note\": \"Updated from Postman collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/admin/budgets/{{budget_id}}",
            "description": "BudgetRequest yêu cầu gửi đầy đủ user_id, category_id, amount_limit, period và status cả khi dùng PATCH."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Budget is updated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.amount_limit).to.eql(1500000);",
                  "    pm.expect(data.status).to.eql('inactive');",
                  "});"
                ]
              }
            }
          ]
        },
