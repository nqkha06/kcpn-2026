  "item": [
    {
      "name": "00 - Authentication",
      "description": "Chạy theo thứ tự để Postman lưu XSRF-TOKEN và laravel_session trong cookie jar. Điền admin_password trong collection variables trước khi chạy Login.",
      "item": [
        {
          "name": "GET /sanctum/csrf-cookie",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/sanctum/csrf-cookie",
            "description": "Backend đăng ký route này tại /api/v1/sanctum/csrf-cookie. Response 204 sẽ đặt cookie XSRF-TOKEN và session cookie."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF cookie response is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "const encodedToken = pm.cookies.get('XSRF-TOKEN');",
                  "pm.test('XSRF-TOKEN cookie is present', function () {",
                  "    pm.expect(encodedToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (encodedToken) {",
                  "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(encodedToken));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (helper)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{admin_email}}\",\n    \"password\": \"{{admin_password}}\",\n    \"remember\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/auth/login",
            "description": "Request hỗ trợ xác thực session Sanctum. Điền collection variable admin_password bằng mật khẩu admin cục bộ."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const roles = pm.response.json().data.user.roles || [];",
                  "    pm.test('Authenticated account has admin role', function () {",
                  "        pm.expect(roles).to.include('admin');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
