{
  "info": {
    "_postman_id": "8c35a8f4-6d9b-449e-b9b5-c0d11f9ae234",
    "name": "Transactions, Admin Dashboard & Admin Roles",
    "description": "Bộ sưu tập kiểm thử API cho phân hệ Transactions, Admin Dashboard và Admin Roles trong dự án KCPN 2026. Tích hợp sẵn cơ chế CSRF/Sanctum tự động.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Origin', value: pm.variables.replaceIn('{{frontend_url}}') });",
          "pm.request.headers.upsert({ key: 'Referer', value: pm.variables.replaceIn('{{frontend_url}}/') });",
          "",
          "const unsafeMethods = ['POST', 'PUT', 'PATCH', 'DELETE'];",
          "const xsrfToken = pm.collectionVariables.get('xsrf_token');",
          "if (unsafeMethods.includes(pm.request.method) && xsrfToken) {",
          "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: xsrfToken });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_base_url",
      "value": "{{base_url}}/api/v1",
      "type": "string"
    },
    {
      "key": "frontend_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "xsrf_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "transaction_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "role_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - CSRF & Auth Helpers",
      "item": [
        {
          "name": "GET /sanctum/csrf-cookie (Khởi tạo Cookie)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/sanctum/csrf-cookie",
            "description": "Gọi API này trước tiên để nhận XSRF-TOKEN cookie."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF cookie response is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "const encodedToken = pm.cookies.get('XSRF-TOKEN');",
                  "if (encodedToken) {",
                  "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(encodedToken));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (Đăng nhập Admin/User)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password\",\n    \"remember\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/auth/login",
            "description": "Đăng nhập tài khoản. Chú ý gán vai trò 'admin' hoặc 'user' cho tài khoản này trước."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - User Transactions",
      "item": [
        {
          "name": "GET /user/transactions (Danh sách giao dịch)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/user/transactions?page=1&per_page=15",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "user",
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "15"
                }
              ]
            },
            "description": "Lấy danh sách giao dịch chi tiêu/thu nhập của User hiện tại."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get transactions succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /user/transactions (Tạo giao dịch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"wallet_id\": 1,\n    \"category_id\": 1,\n    \"type\": \"expense\",\n    \"amount\": 50000,\n    \"transacted_at\": \"2026-07-29\",\n    \"note\": \"Ăn trưa văn phòng\",\n    \"labels\": [\"ăn-uống\", \"demo\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/user/transactions",
            "description": "Tạo một giao dịch chi tiêu mới. Lưu ý: `wallet_id` và `category_id` phải tồn tại trong DB của user này."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create transaction succeeds', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.success).to.eql(true);",
                  "    pm.collectionVariables.set('transaction_id', responseJson.data.id);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
