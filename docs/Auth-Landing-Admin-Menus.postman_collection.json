{
  "info": {
    "_postman_id": "1f9e6e81-d466-4794-8ed7-87bcfc4968df",
    "name": "Auth, Landing, Admin Menus",
    "description": "Bộ sưu tập Postman hỗ trợ kiểm thử API **xác thực người dùng, dữ liệu công khai và quản lý menu quản trị**, tích hợp Laravel Sanctum, CSRF và các test script tự động.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Origin', value: pm.variables.replaceIn('{{frontend_url}}') });",
          "pm.request.headers.upsert({ key: 'Referer', value: pm.variables.replaceIn('{{frontend_url}}/') });",
          "",
          "const unsafeMethods = ['POST', 'PUT', 'PATCH', 'DELETE'];",
          "const xsrfToken = pm.collectionVariables.get('xsrf_token');",
          "if (unsafeMethods.includes(pm.request.method) && xsrfToken) {",
          "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: xsrfToken });",
          "}"
        ]
      }
    }
  ],
  "variable": [
