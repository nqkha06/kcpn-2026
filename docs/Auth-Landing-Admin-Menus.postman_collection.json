  "item": [
    {
      "name": "00 - Sanctum Setup",
      "description": "Chạy request này trước mọi POST/PATCH/DELETE để Postman lưu XSRF-TOKEN và laravel_session trong cookie jar.",
      "item": [
        {
          "name": "GET /sanctum/csrf-cookie (helper)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/sanctum/csrf-cookie",
            "description": "Route thực tế là /api/v1/sanctum/csrf-cookie. Response 204 đặt cookie XSRF-TOKEN và session cookie."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF cookie response is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "const encodedToken = pm.cookies.get('XSRF-TOKEN');",
                  "pm.test('XSRF-TOKEN cookie is present', function () {",
                  "    pm.expect(encodedToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (encodedToken) {",
                  "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(encodedToken));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Auth",
      "description": "Register tạo một user thử nghiệm có email kèm timestamp. Login sau đó đăng nhập tài khoản admin để chuẩn bị cho Admin Menus. Reset Password cần lấy token từ email/log; Two-Factor Challenge cần phiên đăng nhập của tài khoản đã bật 2FA.",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Postman Test User\",\n    \"email\": \"postman.user.{{$timestamp}}@example.com\",\n    \"password\": \"{{registered_password}}\",\n    \"password_confirmation\": \"{{registered_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/auth/register",
            "description": "Tạo user mới với role user và đăng nhập user đó vào session hiện tại. Email động tránh lỗi trùng dữ liệu."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User is registered', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.user.roles).to.include('user');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('registered_email', pm.response.json().data.user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{admin_email}}\",\n    \"password\": \"{{admin_password}}\",\n    \"remember\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/auth/login",
            "description": "Điền admin_password trong collection variables. Request này thay session user vừa đăng ký bằng session admin dùng cho Menu CRUD."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "",
                  "if (pm.response.code === 200 && !pm.response.json().data.requires_two_factor) {",
                  "    pm.test('Authenticated account has admin role', function () {",
                  "        pm.expect(pm.response.json().data.user.roles).to.include('admin');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/auth/me"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current admin session is returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const user = pm.response.json().data.user;",
                  "    pm.expect(user.email).to.eql(pm.collectionVariables.get('admin_email').toLowerCase());",
                  "    pm.expect(user.roles).to.include('admin');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/forgot-password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{registered_email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/auth/forgot-password",
            "description": "Gửi yêu cầu reset cho user thử nghiệm vừa đăng ký. Với MAIL_MAILER=log, lấy token trong storage/logs/laravel.log hoặc URL reset được ghi vào log."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Password reset link is requested', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/reset-password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"token\": \"{{reset_token}}\",\n    \"email\": \"{{registered_email}}\",\n    \"password\": \"{{reset_new_password}}\",\n    \"password_confirmation\": \"{{reset_new_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/auth/reset-password",
            "description": "Điền reset_token lấy từ email hoặc storage/logs/laravel.log. Nếu biến đang trống, response 422 là kết quả mong đợi vì token là bắt buộc."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resetToken = pm.collectionVariables.get('reset_token');",
                  "if (resetToken) {",
                  "    pm.test('Password is reset with supplied token', function () {",
                  "        pm.response.to.have.status(200);",
                  "        pm.expect(pm.response.json().success).to.eql(true);",
                  "    });",
                  "} else {",
                  "    pm.test('Empty reset token is rejected', function () {",
                  "        pm.response.to.have.status(422);",
                  "        pm.expect(pm.response.json().errors).to.have.property('token');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/two-factor-challenge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"code\": \"{{two_factor_code}}\",\n    \"recovery_code\": \"{{two_factor_recovery_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/auth/two-factor-challenge",
            "description": "Chỉ chạy thành công sau khi Login bằng tài khoản đã bật 2FA và response yêu cầu two-factor. Điền một trong two_factor_code hoặc two_factor_recovery_code. Nếu cả hai trống, response 422 là mong đợi."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hasChallengeValue = pm.collectionVariables.get('two_factor_code') || pm.collectionVariables.get('two_factor_recovery_code');",
                  "if (hasChallengeValue) {",
                  "    pm.test('Two-factor challenge succeeds', function () {",
                  "        pm.response.to.have.status(200);",
                  "        pm.expect(pm.response.json().data.requires_two_factor).to.eql(false);",
                  "    });",
                  "} else {",
                  "    pm.test('Missing two-factor code is rejected', function () {",
                  "        pm.response.to.have.status(422);",
                  "        pm.expect(pm.response.json().success).to.eql(false);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Public",
      "item": [
        {
          "name": "GET /public/configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/public/configuration?locale={{public_locale}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "public",
                "configuration"
              ],
              "query": [
                {
                  "key": "locale",
                  "value": "{{public_locale}}",
                  "description": "Hỗ trợ vi hoặc en"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Public configuration is returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.locale).to.eql(pm.collectionVariables.get('public_locale'));",
                  "    pm.expect(json.data).to.have.property('menus');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /public/pages/{slug}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/public/pages/{{public_page_slug}}",
            "description": "public_page_slug phải trỏ tới page có status published. Route hỗ trợ slug lồng nhau như guides/getting-started."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Published page is returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.slug).to.eql(pm.collectionVariables.get('public_page_slug'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Admin Menus",
      "description": "Chạy cả folder theo thứ tự. Create lưu data.id vào menu_id; Parent Options, Show, Update và Delete dùng lại ID đó. Delete chỉ xóa menu do collection vừa tạo.",
      "item": [
        {
          "name": "GET /admin/menus",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/admin/menus?per_page=15&page=1",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "admin",
                "menus"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "active",
                  "disabled": true,
                  "description": "active hoặc inactive"
                },
                {
                  "key": "canonical",
                  "value": "home.header",
                  "disabled": true
                },
                {
                  "key": "parent_id",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "sort_order",
                  "disabled": true,
                  "description": "id, title, canonical, sort_order, status hoặc created_at"
                },
                {
                  "key": "direction",
                  "value": "asc",
                  "disabled": true
                },
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Menu list is paginated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.meta).to.have.property('total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /admin/menus",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Postman Menu {{$timestamp}}\",\n    \"url\": \"/postman-menu\",\n    \"parent_id\": null,\n    \"canonical\": \"home.header\",\n    \"sort_order\": 999,\n    \"target\": \"_self\",\n    \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/admin/menus",
            "description": "canonical phải có dạng home.header, home.footer hoặc user.header. target chỉ nhận _self hoặc _blank."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Menu is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.canonical).to.eql('home.header');",
                  "    pm.expect(data.status).to.eql('active');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('menu_id', String(pm.response.json().data.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /admin/menus/parent-options",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/admin/menus/parent-options?exclude={{menu_id}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "admin",
                "menus",
                "parent-options"
              ],
              "query": [
                {
                  "key": "exclude",
                  "value": "{{menu_id}}",
                  "description": "Tùy chọn: loại menu hiện tại khỏi danh sách parent để tránh tự tham chiếu."
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Parent menu options are returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data).to.be.an('array');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const excludedId = pm.collectionVariables.get('menu_id');",
                  "    const returnedIds = pm.response.json().data.map(function (menu) { return String(menu.id); });",
                  "    pm.test('Created menu is excluded from parent options', function () {",
                  "        pm.expect(returnedIds).not.to.include(excludedId);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /admin/menus/{menu}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base_url}}/admin/menus/{{menu_id}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created menu is returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(String(pm.response.json().data.id)).to.eql(pm.collectionVariables.get('menu_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /admin/menus/{menu}",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Postman Menu Updated\",\n    \"url\": \"/postman-menu-updated\",\n    \"parent_id\": null,\n    \"canonical\": \"home.footer\",\n    \"sort_order\": 998,\n    \"target\": \"_blank\",\n    \"status\": \"inactive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{api_base_url}}/admin/menus/{{menu_id}}",
            "description": "MenuRequest yêu cầu title, canonical, target và status cả khi dùng PATCH."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Menu is updated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.title).to.eql('Postman Menu Updated');",
                  "    pm.expect(data.canonical).to.eql('home.footer');",
                  "    pm.expect(data.target).to.eql('_blank');",
                  "    pm.expect(data.status).to.eql('inactive');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /admin/menus/{menu}",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{api_base_url}}/admin/menus/{{menu_id}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Menu is deleted', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().message).to.eql('Menu deleted successfully');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Auth Cleanup",
      "description": "Logout được đặt cuối để không làm mất session admin trước khi chạy các API Admin Menus.",
      "item": [
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base_url}}/auth/logout"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Session is logged out', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().message).to.eql('Logout successful');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
